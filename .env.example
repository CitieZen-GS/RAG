# Exemplo de variáveis de ambiente. NÃO coloque credenciais reais neste arquivo.
# Copie para .env (ignorado pelo Git) se quiser guardar valores locais.
#
# Em desenvolvimento nenhuma variável é obrigatória: o dockerfiles/compose.yaml fornece
# Oracle e RabbitMQ. Na Azure, os valores vêm das Variables da pipeline (azure-pipeline.yml),
# com as senhas marcadas como secretas.

# Banco Oracle
SPRING_DATASOURCE_URL=jdbc:oracle:thin:@//<host>:1521/<servico>
SPRING_DATASOURCE_USERNAME=<usuario>
SPRING_DATASOURCE_PASSWORD=<senha>

# RabbitMQ
SPRING_RABBITMQ_HOST=<host>
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=<usuario>
SPRING_RABBITMQ_PASSWORD=<senha>

# JWT: mesmo segredo nas 3 APIs (HS256, mínimo 32 caracteres)
JWT_SEGREDO=<segredo-com-no-minimo-32-caracteres>

# IA generativa (OpenAI via Spring AI)
OPENAI_API_KEY=<sua-chave-da-openai>
# Opcional: modelo usado (padrão gpt-5-mini)
OPENAI_MODELO=gpt-5-mini
